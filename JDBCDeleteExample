import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.SQLException;

public class JDBCDeleteExample {

    // Database credentials and URL
    // Replace 'mydatabase' with your actual database name
    private static final String URL = "jdbc:mysql://localhost:3306/mydatabase";
    private static final String USER = "root";
    private static final String PASSWORD = "password123";

    public static void main(String[] args) {
        // SQL query with a placeholder (?) for the conditional deletion
        String deleteSQL = "DELETE FROM employees WHERE employee_id = ?";

        // Using try-with-resources to ensure automatic closure of database connections
        try (Connection connection = DriverManager.getConnection(URL, USER, PASSWORD);
             PreparedStatement preparedStatement = connection.prepareStatement(deleteSQL)) {
            
            System.out.println("Connected to the database successfully!");

            // Bind the value to the placeholder (e.g., deleting employee with ID 101)
            int employeeIdToDelete = 101;
            preparedStatement.setInt(1, employeeIdToDelete);

            // Execute the delete operation
            int rowsDeleted = preparedStatement.executeUpdate();

            // Verify if any rows were actually deleted
            if (rowsDeleted > 0) {
                System.out.println("Success! " + rowsDeleted + " row(s) were deleted.");
            } else {
                System.out.println("No record found with the specified ID. Zero rows deleted.");
            }

        } catch (SQLException e) {
            System.err.println("Database error occurred: " + e.getMessage());
            e.printStackTrace();
        }
    }
}
